# Local Django API (www_kudya_shop on port 8000)
# Android emulator: http://10.0.2.2:8000 (physical devices auto-remap to Expo LAN IP)
# Physical device: same Wi‑Fi as PC — leave 10.0.2.2 or set http://YOUR_PC_LAN_IP:8000
# Cursor/browser web: http://127.0.0.1:8000 or leave unset — web uses localhost automatically
EXPO_PUBLIC_BASE_API=http://10.0.2.2:8000
# Production API (EAS production profile — required for store builds):
# EXPO_PUBLIC_BASE_API=https://www.kudya.store
# EXPO_PUBLIC_USE_PRODUCTION_API=true

# Crash reporting (required for production monitoring)
EXPO_PUBLIC_SENTRY_DSN=

# Public web app URL for share links
EXPO_PUBLIC_WEB_APP_URL=https://kudya.online
# Google OAuth (Cloud Console — add redirect: http://localhost:8081 for web / Cursor browser)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Meta (Facebook Login — same app id as backend FACEBOOK_APP_ID)
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Instagram (Meta app — can share Facebook app or separate Instagram product)
EXPO_PUBLIC_INSTAGRAM_APP_ID=

# TikTok Login Kit
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=

# Google Maps + Places autocomplete (rides pickup/destination search)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
